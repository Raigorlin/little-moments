# LM reverse proxy（Requirement 20.2、20.3；design.md Components §12）。
# 安裝於 /srv/lm/<env>/caddy/Caddyfile，唯讀掛載至 proxy 容器 /etc/caddy。
#
# 環境變數（由 compose.yaml 提供；{$VAR} 在解析前替換）：
#   LM_SITE_ADDRESS  站台位址，預設 http://:8080；HTTPS 時例如 https://<lan-hostname>:8443
#   LM_TLS_MODE      off｜internal｜file，選擇 import 的 tls-<mode>.caddy
#   LM_HEALTH_HOST   主動健康檢查送出的 Host 標頭（必須在 App 的 Allowed_Hosts 內）
#   LM_EDGE_TRUSTED_PROXIES
#                    Edge_Trusted_Proxies（Req 25.7）：以空白分隔的 IPv4／IPv6 位址或 CIDR（1–64 項），只有 TCP 來源
#                    在其中的請求，其 X-Forwarded-For／X-Forwarded-Proto 才會被採信（Req 25.1–25.5）。compose.yaml 與
#                    本檔的預設皆為 127.0.0.1/32：容器內沒有任何請求從 loopback 連到站台監聽埠，等同不信任任何來源
#                    （Req 25.6）。格式由 lm-deploy 在任何 Docker 動作前驗證（Req 25.8）；Caddy 無法解析時啟動或
#                    reload 失敗並保留舊設定（Req 25.9）。變更後須重新建立 proxy 容器，`caddy reload` 看不到新的環境變數。
#
# Blue/green：實際上游只寫在 upstream.caddy（由 lm-deploy 以 upstream.caddy.tmpl 產生並以 rename 原子替換），
# 之後執行 `caddy reload --config /etc/caddy/Caddyfile`。upstream.caddy 一次只指向一個顏色，
# 使用者請求只會導向目前作用中的槽位；新槽位在切換前不接收任何使用者請求（Req 20.2）。

{
	# 管理 API 只在容器自身的 loopback 上，供 `caddy reload` 使用；不對任何網路公開。
	admin localhost:2019
	# reload 時舊設定的既有連線最多 30 秒內完成（Req 20.3）。
	grace_period 30s
	# 不使用 ACME、不自動產生 http→https 轉址；TLS 由 tls-<mode>.caddy 明確決定。
	auto_https disable_redirects
	servers {
		# Edge_Trusted_Proxies（Req 25.7）。只有 TCP 來源在此清單內的請求，{client_ip} 才會取自 X-Forwarded-For，
		# reverse_proxy 也才會沿用傳入的 X-Forwarded-Proto；其他來源一律以 TCP 來源與連線協定為準（Req 25.2）。
		trusted_proxies static {$LM_EDGE_TRUSTED_PROXIES:127.0.0.1/32}
		# 由右往左解析 X-Forwarded-For，跳過無法解析與受信任的項目，取第一個不受信任的位址（Req 25.3）；
		# 用戶端自行加在最左側的位址不會成為用戶端 IP。
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
	log {
		output stdout
		format json
	}
}

{$LM_SITE_ADDRESS:http://:8080} {
	import /etc/caddy/tls-{$LM_TLS_MODE:off}.caddy

	# 與 App 的 maxRequestBodySize（4 MiB）一致。
	request_body {
		max_size 4MB
	}

	header -Server

	# 受信任來源送來的 X-Forwarded-Proto 只接受恰為 http 或 https（Req 25.4、25.5）。其他值、多個值
	# （多個標頭行以逗號合併後比對）一律移除，reverse_proxy 的預設行為即改以本次連線的協定設定。
	# 不使用 header_regexp：它只要任一標頭行符合就成立，而 reverse_proxy 沿用的是最後一行。
	@xfp_invalid {
		header X-Forwarded-Proto *
		not vars {http.request.header.X-Forwarded-Proto} http https
	}
	request_header @xfp_invalid -X-Forwarded-Proto

	# /healthz 只供 Deploy_Host 從容器網路內部呼叫；對外一律 404（design Components §2）。
	@healthz path /healthz /healthz/*
	handle @healthz {
		respond 404
	}

	handle {
		import /etc/caddy/upstream.caddy
	}

	log
}
