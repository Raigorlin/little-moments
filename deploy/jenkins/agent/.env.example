# agent 的 compose 變數（複製為 .env，不提交）。
#
# trusted 與 untrusted agent 在主機上放在不同目錄、各自使用自己的 .env：
#   trusted    由 root 管理的目錄（例如 /opt/lm-jenkins-agent），只需要 LM_JENKINS_URL 與 DOCKER_GID
#   untrusted  lm-untrusted 家目錄下的目錄，只需要 LM_JENKINS_URL、SOCK 與 SOCK_GID
# compose 從專案目錄讀取 .env；兩者放在同一目錄會共用同一份 .env 與 secret 目錄。

# 兩者共用：agent 直接連到 controller 的 LAN 位址（不經 Nginx Proxy Manager）。
LM_JENKINS_URL=http://<lan-ip>:8080/

# trusted：主機 docker 群組的 gid
#   getent group docker | cut -d: -f3
DOCKER_GID=<gid of docker group>

# untrusted：lm-untrusted 的 rootless Docker socket
#   echo "/run/user/$(id -u lm-untrusted)/docker.sock"
SOCK=/run/user/<uid>/docker.sock
# untrusted：容器內看到的 socket 群組（rootless 下 lm-untrusted 的群組在容器內對應為 0，通常為 0）。
# 以 lm-untrusted 身分、經 rootless daemon 確認（先以 untrusted.compose.yaml build 出 lm-untrusted-agent）：
#   docker run --rm --entrypoint stat -v "$SOCK:/s" lm-untrusted-agent -c %g /s
SOCK_GID=<gid>
