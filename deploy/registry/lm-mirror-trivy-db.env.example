# /usr/local/sbin/lm-mirror-trivy-db 的設定（安裝為 /etc/lm-mirror-trivy-db.env，0600 root:root）。
# 以 POSIX sh 的 `.` 載入，值須加引號。所有 <...> 皆為 PLACEHOLDER，必須在 Registry 主機上替換。
# 本檔不含密碼：PASS 只是密碼檔的路徑。

# LAN Registry 的 <主機名稱>:<連接埠>。
REG='<registry-host>:<port>'
# lm-push 密碼檔路徑（只含密碼，0600 root:root）。
PASS='<path-to-lm-push-password-file>'
# 鏡像後的 crane 映像（deploy/registry/mirror.sh 輸出的 .../mirror/crane@sha256:<digest>）。
CRANE='<registry-host>:<port>/little-moments/mirror/crane@sha256:<digest>'
