# Staging 的 Compose 變數範本（非秘密）。安裝為 /srv/lm/staging/staging.env（0644 root）。
# 所有 <...> 皆為 PLACEHOLDER，必須在 Deploy_Host 上替換；不得提交實際值。
# 秘密（Supabase 的 DB 密碼、JWT secret 與金鑰）不放在這裡，放在 app.env（0600，見 app.env.example）。
# Staging 使用獨立的 Compose 專案 lm-staging、獨立的 Supabase stack、Database 卷與金鑰，且只含合成資料（Req 18.6）。
LM_ENV=staging
LAN_IP=<deploy-host-lan-ip>
LM_PUBLIC_PORT=8081
LM_LISTEN_PORT=8080
# TLS 模式（off｜internal｜file）。
LM_SITE_ADDRESS=http://:8080
LM_TLS_MODE=off
# LM_Proxy 接受的 Host（空白分隔、1–16 個主機名稱或 IPv4，不得含 *；說明見 prod.env.example）。
LM_ALLOWED_HOSTS=<lan-hostname> <deploy-host-lan-ip>
LM_HEALTH_HOST=<deploy-host-lan-ip>
# Edge_Trusted_Proxies 與其範圍檢查用的 LAN 網段（Req 25.6–25.8，說明見 prod.env.example）。
# Staging 不經 Edge_Proxy 公開，兩者保持空白：LM_Proxy 不採信任何來源送來的 X-Forwarded-For／X-Forwarded-Proto。
LM_EDGE_TRUSTED_PROXIES=
LM_LAN_CIDR=
# 必須與 prod 使用不同子網。
APP_SUBNET=172.30.20.0/24
PROXY_IP=172.30.20.2
LM_CADDY_DIR=./caddy
APP_CPUS=0.5
APP_MEMORY=256M
DB_CPUS=0.5
DB_MEMORY=512M
AUTH_MEMORY=128M
REALTIME_MEMORY=384M
GATEWAY_MEMORY=64M
# APP_IMAGE_* 由 lm-deploy 提供（${LM_IMAGE_REPO}@sha256:...），不寫在這裡。
LM_IMAGE_REPO=registry.our-littlemoments.com:8443/little-moments
# Auth 的 Site URL（http(s) origin）：Staging 只在 LAN 內經 LM_Proxy 使用。
LM_SITE_URL=http://<deploy-host-lan-ip>:8081
# 公開註冊（不經邀請的註冊，plan.md D9）的初始值；管理員在管理後台（/admin）儲存設定之後不再生效。
# Staging 為 true，Staging 的 smoke（--provision）在登入回應 401 時註冊 smoke-bot。
LM_PUBLIC_SIGNUP=true
# 合成 email 的網域；空白時為 users.little-moments.invalid。
LM_AUTH_EMAIL_DOMAIN=
