# Staging 的 Compose 變數範本（非秘密）。安裝為 /srv/lm/staging/staging.env（0644 root）。
# 所有 <...> 皆為 PLACEHOLDER，必須在 Deploy_Host 上替換；不得提交實際值。
# 秘密（DB 密碼、Setup_Token）不放在這裡，放在 app.env／db.env（0600）。
# Staging 使用獨立的 Compose 專案 lm-staging、獨立 Database 卷與憑證，且只含合成資料（Req 18.6）。

LM_ENV=staging

LAN_IP=<deploy-host-lan-ip>
LM_PUBLIC_PORT=8081
LM_LISTEN_PORT=8080

# TLS 模式（off｜internal｜file）。
LM_SITE_ADDRESS=http://:8080
LM_TLS_MODE=off

ALLOWED_HOSTS=<lan-hostname>,<deploy-host-lan-ip>
LM_HEALTH_HOST=<lan-hostname>

# Edge_Trusted_Proxies 與其範圍檢查用的 LAN 網段（Req 25.6–25.8，說明見 prod.env.example）。
# Staging 不經 Edge_Proxy 公開，兩者保持空白：LM_Proxy 不採信任何來源送來的 X-Forwarded-For／X-Forwarded-Proto。
LM_EDGE_TRUSTED_PROXIES=
LM_LAN_CIDR=

# 必須與 prod 使用不同子網。
APP_SUBNET=172.30.20.0/24
PROXY_IP=172.30.20.2

LM_CADDY_DIR=./caddy

APP_CPUS=0.5
APP_MEMORY=384M
DB_CPUS=0.5
DB_MEMORY=512M

# APP_IMAGE_* 由 lm-deploy 提供（${LM_IMAGE_REPO}@sha256:...），不寫在這裡。
LM_IMAGE_REPO=registry.our-littlemoments.com:8443/little-moments

# 公開註冊政策的啟動初始值（Registration_Seed，Req 26.16）：open 或 closed；未設定或空白時 compose.yaml 傳入 closed。
# 管理員在 /admin 儲存的值優先，儲存後此值不再生效（恢復方式見 README）。
CAMPING_REGISTRATION=closed

# 雲端 AI 收據辨識（OpenAI）在 Staging 停用（Req 15.6）：以下四行保持空白。值由 lm-deploy 決定，非空值會被拒絕
# （config_invalid）；lm-deploy staging 也拒絕任何金鑰與金鑰檔。金鑰不放在這裡（見 prod.env.example）。
CAMPING_OPENAI_API_KEY_FILE=
CAMPING_OPENAI_MODEL_ID=
CAMPING_OPENAI_IMAGE_DETAIL=
CAMPING_OPENAI_MAX_COMPLETION_TOKENS=
