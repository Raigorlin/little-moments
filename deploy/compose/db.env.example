# PostgreSQL 容器的初始化設定範本。實際檔案為 /srv/lm/<env>/db.env，權限 0600、擁有者 root。
# 只在資料卷第一次初始化時使用；值必須與同環境 app.env 的 CAMPING_DATABASE_* 一致。
# 所有 <...> 皆為 PLACEHOLDER，不得提交實際值。

POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
