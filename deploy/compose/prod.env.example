# Production 的 Compose 變數範本（非秘密）。安裝為 /srv/lm/prod/prod.env（0644 root）。
# 所有 <...> 皆為 PLACEHOLDER，必須在 Deploy_Host 上替換；不得提交實際值。
# 秘密（DB 密碼、Setup_Token）不放在這裡，放在 app.env／db.env（0600）。

LM_ENV=prod

# 對 LAN 發布 proxy 的位址與連接埠。LAN 網段以外的來源由 DOCKER-USER 規則拒絕（Req 8.6）。
LAN_IP=<deploy-host-lan-ip>
LM_PUBLIC_PORT=80
LM_LISTEN_PORT=8080

# Caddy 站台位址與 TLS 模式（off｜internal｜file，見 deploy/caddy/tls-*.caddy）。
# HTTPS 範例：LM_SITE_ADDRESS=https://<lan-hostname>:8443、LM_LISTEN_PORT=8443、LM_PUBLIC_PORT=443、LM_TLS_MODE=internal
LM_SITE_ADDRESS=http://:8080
LM_TLS_MODE=off

# App 的 Allowed_Hosts（逗號分隔，不得含 *）；LM_HEALTH_HOST 必須是其中一項，供 proxy 健康檢查使用。
ALLOWED_HOSTS=<lan-hostname>,<deploy-host-lan-ip>
LM_HEALTH_HOST=<lan-hostname>

# app 網路固定子網與 proxy 固定 IP。App 只採信 PROXY_IP/32 的 X-Forwarded-*；
# 必須與 staging 使用不同子網，且不得與 LAN 網段重疊。
APP_SUBNET=172.30.10.0/24
PROXY_IP=172.30.10.2

# deploy/caddy/ 安裝位置（相對於本專案目錄）。
LM_CADDY_DIR=./caddy

# 資源上限。
APP_CPUS=1.0
APP_MEMORY=512M
DB_CPUS=1.0
DB_MEMORY=1G

# APP_IMAGE_BLUE／APP_IMAGE_GREEN／APP_IMAGE_NEW 不寫在這裡：lm-deploy 每次執行時由 state/lm.state
# 與 Pipeline 傳入的 digest 決定，格式一律為 ${LM_IMAGE_REPO}@sha256:<64 hex>。
# lm-deploy 只接受這個 repository 的映像（Pipeline 傳入 repo@digest 時 repo 必須相同）。
LM_IMAGE_REPO=<registry-host>:<port>/little-moments

# 雲端 AI 收據辨識預設停用（Req 15.6）。保持空白；啟用流程見 README（Req 15.7）。
CAMPING_BEDROCK_REGION=
CAMPING_BEDROCK_MODEL_ID=
CAMPING_BEDROCK_API_KEY=
