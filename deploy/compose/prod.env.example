# Production 的 Compose 變數範本（非秘密）。安裝為 /srv/lm/prod/prod.env（0644 root）。
# 所有 <...> 皆為 PLACEHOLDER，必須在 Deploy_Host 上替換；不得提交實際值。
# 秘密（DB 密碼、Setup_Token）不放在這裡，放在 app.env／db.env（0600）。

LM_ENV=prod

# 對 LAN 發布 proxy 的位址與連接埠。LAN 網段以外的來源由 DOCKER-USER 規則拒絕（Req 8.6）。
# 主機的 80／443 由同主機的 Edge_Proxy（Nginx Proxy Manager）使用，網際網路請求經 Edge_Proxy 轉送至此連接埠
# （Req 25；不得等於 install.sh --public-port 宣告的任何 Public_Port）。
LAN_IP=<deploy-host-lan-ip>
LM_PUBLIC_PORT=8082
LM_LISTEN_PORT=8080

# Caddy 站台位址與 TLS 模式（off｜internal｜file，見 deploy/caddy/tls-*.caddy）。經 Edge_Proxy 公開時維持 http，
# TLS 由 Edge_Proxy 終止。HTTPS 範例（僅 LAN；LM_PUBLIC_PORT 不得使用 Edge_Proxy 的 80／443 或 Registry 的 8443）：
# LM_SITE_ADDRESS=https://<lan-hostname>:8443、LM_LISTEN_PORT=8443、LM_PUBLIC_PORT=8444、LM_TLS_MODE=internal
LM_SITE_ADDRESS=http://:8080
LM_TLS_MODE=off

# App 的 Allowed_Hosts（逗號分隔，不得含 *）；LM_HEALTH_HOST 必須是其中一項，供 proxy 健康檢查使用。
# <public-hostname> 為經 Edge_Proxy 公開的主機名稱；<deploy-host-lan-ip> 供 LAN 內的 Smoke_Test 直接連線。
ALLOWED_HOSTS=<public-hostname>,<deploy-host-lan-ip>
LM_HEALTH_HOST=<public-hostname>

# Edge_Trusted_Proxies（Req 25.7）：以空白分隔、1–64 個 IPv4／IPv6 位址或 CIDR。只有 TCP 來源在其中的請求，
# LM_Proxy 才採信其 X-Forwarded-For／X-Forwarded-Proto；空白時不信任任何來源（Req 25.6）。
#   <npm-docker-subnet>       Edge_Proxy 連到 LM_Proxy 時 LM_Proxy 實際看到的來源（Edge_Proxy 容器所在 Docker 網段，
#                             或以存取日誌 request.remote_ip 確認的 /32）；不得涵蓋整個 LAN 或 Docker 預設 bridge 網段。
#   <cloudflare-ipv4-ranges>  https://www.cloudflare.com/ips-v4 的全部項目（維運者維護的靜態清單）。
#   <cloudflare-ipv6-ranges>  https://www.cloudflare.com/ips-v6 的全部項目。
# 更新方式：下載兩份清單 → 與本檔現值比對 → 更新此行 → 重新建立 proxy 容器（docker compose … up -d --no-deps proxy）
# → 確認經公開網址的請求在 LM_Proxy 存取日誌中記錄真實用戶端 IP。
# lm-deploy 拒絕無法解析的項目、超過 64 項、前綴 0（0.0.0.0/0、::/0）、IPv4-mapped IPv6，以及涵蓋 LM_LAN_CIDR
# 任一整個網段的項目（Req 25.8）。
LM_EDGE_TRUSTED_PROXIES=<npm-docker-subnet> <cloudflare-ipv4-ranges> <cloudflare-ipv6-ranges>
# Deploy_Host 所在的實體 LAN 網段（逗號分隔、1–8 個 IPv4 網路位址 CIDR），只用於上述範圍檢查；
# 與 install.sh --lan-cidr 不同（後者另含 Edge_Proxy 與 Docker bridge 網段）。LM_EDGE_TRUSTED_PROXIES 非空時必填。
LM_LAN_CIDR=<lan-cidr>

# app 網路固定子網與 proxy 固定 IP。App 只採信 PROXY_IP/32 的 X-Forwarded-*；
# 必須與 staging 使用不同子網，且不得與 LAN 網段重疊。
APP_SUBNET=172.30.10.0/24
PROXY_IP=172.30.10.2

# deploy/caddy/ 安裝位置（相對於本專案目錄）。
LM_CADDY_DIR=./caddy

# 資源上限。
APP_CPUS=1.0
APP_MEMORY=512M
DB_CPUS=1.0
DB_MEMORY=1G

# APP_IMAGE_BLUE／APP_IMAGE_GREEN／APP_IMAGE_NEW 不寫在這裡：lm-deploy 每次執行時由 state/lm.state
# 與 Pipeline 傳入的 digest 決定，格式一律為 ${LM_IMAGE_REPO}@sha256:<64 hex>。
# lm-deploy 只接受這個 repository 的映像（Pipeline 傳入 repo@digest 時 repo 必須相同）。
LM_IMAGE_REPO=registry.our-littlemoments.com:8443/little-moments

# 公開註冊政策的啟動初始值（Registration_Seed，Req 26.16）：open 或 closed；未設定或空白時 compose.yaml 傳入 closed。
# 管理員在 /admin 儲存的值優先，儲存後此值不再生效（恢復方式見 README）。
CAMPING_REGISTRATION=closed

# 雲端 AI 收據辨識（OpenAI；Req 15.6、15.7）：以下四行保持空白。值由 lm-deploy 決定，非空值會被拒絕（config_invalid）。
# API 金鑰本身不放在這裡：compose.yaml 將 CAMPING_OPENAI_API_KEY 固定為空字串，金鑰只以金鑰檔提供。
# Production 的金鑰檔為 /srv/lm/prod/secrets/openai-api-key（10001:10001、0400；secrets/ 為 root 0700），由 Production
# Deploy 經 lm-deploy deploy --app-env-stdin 寫入；檔案存在時 lm-deploy 把 CAMPING_OPENAI_API_KEY_FILE 設為
# /run/secrets/openai-api-key。啟用、輪替與停用步驟見 deploy/README.md 的「Production 收據 AI（OpenAI）」。
CAMPING_OPENAI_API_KEY_FILE=
CAMPING_OPENAI_MODEL_ID=
CAMPING_OPENAI_IMAGE_DETAIL=
CAMPING_OPENAI_MAX_COMPLETION_TOKENS=
