# App 容器的秘密範本。實際檔案為 /srv/lm/<env>/app.env，權限 0600、擁有者 root。
# 由 Pipeline 從 Credential_Store 取得後經 stdin 交給 lm-deploy 寫入（Req 15.1、15.2），不得提交實際值。
# 所有 <...> 皆為 PLACEHOLDER。Staging 與 Production 必須使用不同的值（Req 18.6）。

CAMPING_DATABASE_NAME=<database-name>
CAMPING_DATABASE_USER=<database-user>
CAMPING_DATABASE_PASSWORD=<database-password>

# 至少 32 字元（Req 9.3）。省略時 App 會自動產生並只輸出至容器 stdout 一次（Req 9.2）。
CAMPING_SETUP_TOKEN=<setup-token-at-least-32-chars>
