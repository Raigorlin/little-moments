# lm-server 的環境變數（需求 2.7）。複製成 .env 再填值；.env 含金鑰，已被 .gitignore 排除，不要提交。
# lm-server 啟動時以工作目錄或上層目錄中最近的 .env 補上環境中沒有設定的變數；
# 每個值先修剪前後的空白，留空的變數視同未設定。
# 註明「supabase status -o env」的值：在 WSL 中以 supabase start 啟動本機堆疊後，執行這個指令取得。

# 監聽位址，格式為 <IPv4>:<埠> 或 [<IPv6>]:<埠>，不接受主機名稱。留空時為 127.0.0.1:8080
LM_BIND=

# 必要：supabase status -o env 的 DB_URL
DATABASE_URL=

# 必要：supabase status -o env 的 API_URL
SUPABASE_URL=

# 必要：supabase status -o env 的 ANON_KEY
SUPABASE_ANON_KEY=

# 必要：supabase status -o env 的 SERVICE_ROLE_KEY（只給 lm-server 使用）
SUPABASE_SERVICE_KEY=

# supabase status -o env 的 JWT_SECRET。留空時只以 JWKS 驗證，以 HS256 簽署的 access token 一律無效
SUPABASE_JWT_SECRET=

# 合成 email 的網域。留空時為 users.little-moments.invalid
LM_AUTH_EMAIL_DOMAIN=

# 是否開放不經邀請的註冊，只接受 true 或 false。留空時為 true
LM_PUBLIC_SIGNUP=

# 必要：LM_Web 的靜態檔目錄，例如 crates/web/dist（trunk build 的輸出）
LM_STATIC_DIR=
